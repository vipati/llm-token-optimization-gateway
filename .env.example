# Model backend: "mock" (in-process, no setup) or "openai" (any OpenAI-compatible API).
TOKEN_GATEWAY_BACKEND=mock

# For TOKEN_GATEWAY_BACKEND=openai. Examples:
#   Ollama:           http://localhost:11434/v1   (model e.g. llama3.2)
#   OpenAI:           https://api.openai.com/v1   (set TOKEN_GATEWAY_API_KEY)
#   Bundled llmapi:   http://localhost:8001/v1    (model tiny-local-model)
TOKEN_GATEWAY_BASE_URL=http://localhost:11434/v1
TOKEN_GATEWAY_API_KEY=
TOKEN_GATEWAY_MODEL=tiny-local-model
TOKEN_GATEWAY_REQUEST_TIMEOUT_SECONDS=30

# "regex" (deterministic default) or "tiktoken" (install with: uv sync --extra tiktoken)
TOKEN_GATEWAY_TOKENIZER=regex

# Optimization and caching
TOKEN_GATEWAY_MAX_CONTEXT_TOKENS=120
TOKEN_GATEWAY_CACHE_MAX_ENTRIES=10000
TOKEN_GATEWAY_CACHE_TTL_SECONDS=3600
TOKEN_GATEWAY_SEMANTIC_CACHE=true
TOKEN_GATEWAY_SEMANTIC_THRESHOLD=0.8

# Used only for cost estimates in metrics
TOKEN_GATEWAY_PRICE_PER_1K_TOKENS=0.002
